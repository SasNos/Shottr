{
  "name": "shottr-chrome",
  "version": "1.0.7",
  "private": true,
  "type": "module",
  "description": "Chrome extension: full page, area and viewport screenshots with annotations, saved as PNG, WebP or PDF.",
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" --test-coverage-include=\"tools/tokens.mjs\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"test/**/*.test.js\"",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "format": "prettier --write . && eslint --fix . && stylelint --fix \"src/**/*.css\"",
    "format:check": "prettier --check .",
    "tokens": "node tools/tokens.mjs",
    "tokens:check": "node tools/tokens.mjs --check",
    "check": "npm run lint && npm run format:check && npm run tokens:check && npm test",
    "icons": "node tools/make-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0"
  }
}
